  "events": [
    {
      "eventId": "event_07f37de9666a",
      "dayId": "day_1bca3ae59da2",
      "legacyDayAnchor": "itinerary-day-1",
      "legacyEventOrdinal": 1,
      "sourceText": "Arrive at Rome FCO. Pick up bags and take the Leonardo Express to Roma Termini (30 minutes)."
    },
    {
      "eventId": "event_d6b7f467321c",
      "dayId": "day_1bca3ae59da2",
      "legacyDayAnchor": "itinerary-day-1",
      "legacyEventOrdinal": 2,
      "sourceText": "Mercato Centrale inside Roma Termini station."
    },
    {
      "eventId": "event_8dde8012ba30",
      "dayId": "day_1bca3ae59da2",
      "legacyDayAnchor": "itinerary-day-1",
      "legacyEventOrdinal": 3,
      "sourceText": "Check in at The Talent Hotel. Taxi from Termini (€9–11). Stay September 29, 30 and October 1."
    },
    {
      "eventId": "event_02fa46067011",
      "dayId": "day_1bca3ae59da2",
      "legacyDayAnchor": "itinerary-day-1",
      "legacyEventOrdinal": 4,
      "sourceText": "Pantheon entry."
    },
    {
      "eventId": "event_9ff6e3a9dc08",
      "dayId": "day_1bca3ae59da2",
      "legacyDayAnchor": "itinerary-day-1",
      "legacyEventOrdinal": 5,
      "sourceText": "Explore nearby; All'Antico Vinaio is one option."
    },
    {
      "eventId": "event_a66bad4aee3b",
      "dayId": "day_fb6528c95d3c",
      "legacyDayAnchor": "itinerary-day-2",
      "legacyEventOrdinal": 1,
      "sourceText": "Breakfast at the hotel (included)."
    },
    {
      "eventId": "event_cdd2e9116a05",
      "dayId": "day_fb6528c95d3c",
      "legacyDayAnchor": "itinerary-day-2",
      "legacyEventOrdinal": 2,
      "sourceText": "Colosseum tour. Arrive 15 minutes early. Afterward, take a break for snacks around Mercato Rionale Monti or Mizio’s street food."
    },
    {
      "eventId": "event_dbb73a37ace4",
      "dayId": "day_fb6528c95d3c",
      "legacyDayAnchor": "itinerary-day-2",
      "legacyEventOrdinal": 3,
      "sourceText": "Roman Forum & Palatine Hill. Ticket is valid within 24 hours of the Colosseum visit."
    },
    {
      "eventId": "event_030b2676a0fe",
      "dayId": "day_fb6528c95d3c",
      "legacyDayAnchor": "itinerary-day-2",
      "legacyEventOrdinal": 4,
      "sourceText": "Dinner reservation: La Taverna dei Fori Imperiali. Via della Madonna Dei Monti 9."
    },
    {
      "eventId": "event_99363984fa7c",
      "dayId": "day_e788d030175b",
      "legacyDayAnchor": "itinerary-day-3",
      "legacyEventOrdinal": 1,
      "sourceText": "Meet the Vatican tour at Antico Cafe Candia. 25-minute taxi ride from the hotel."
    },
    {
      "eventId": "event_1a43604727ed",
      "dayId": "day_e788d030175b",
      "legacyDayAnchor": "itinerary-day-3",
      "legacyEventOrdinal": 2,
      "sourceText": "Guided Vatican & St. Peter's Basilica tour."
    },
    {
      "eventId": "event_947dc6df556c",
      "dayId": "day_e788d030175b",
      "legacyDayAnchor": "itinerary-day-3",
      "legacyEventOrdinal": 3,
      "sourceText": "Becco (Piazzale degli Eroi 7), then browse Mercato Trionfale for desserts."
    },
    {
      "eventId": "event_9343b024948b",
      "dayId": "day_e788d030175b",
      "legacyDayAnchor": "itinerary-day-3",
      "legacyEventOrdinal": 4,
      "sourceText": "Taxi back to the hotel to rest, then walk to the Spanish Steps and finish at the Trevi Fountain."
    },
    {
      "eventId": "event_0902e06f1518",
      "dayId": "day_e788d030175b",
      "legacyDayAnchor": "itinerary-day-3",
      "legacyEventOrdinal": 5,
      "sourceText": "Pinsitaly Trevi by the fountain."
    },
    {
      "eventId": "event_8af15a044e7a",
      "dayId": "day_ab2a690b820d",
      "legacyDayAnchor": "itinerary-day-4",
      "legacyEventOrdinal": 1,
      "sourceText": "Breakfast at the hotel, then taxi to Roma Termini."
    },
    {
      "eventId": "event_60e900b085c6",
      "dayId": "day_ab2a690b820d",
      "legacyDayAnchor": "itinerary-day-4",
      "legacyEventOrdinal": 2,
      "sourceText": "Italo First Class train #9998 from Roma Termini to Naples Central."
    },
    {
      "eventId": "event_3a9006824ba1",
      "dayId": "day_ab2a690b820d",
      "legacyDayAnchor": "itinerary-day-4",
      "legacyEventOrdinal": 3,
      "sourceText": "Alilauro ferry from Naples Port to Sorrento."
    },
    {
      "eventId": "event_1bb62194c62e",
      "dayId": "day_ab2a690b820d",
      "legacyDayAnchor": "itinerary-day-4",
      "legacyEventOrdinal": 4,
      "sourceText": "Al Centro Suites. Seven-minute walk from the port. Stay October 2, 3 and 4."
    },
    {
      "eventId": "event_29a69bfb47c7",
      "dayId": "day_ab2a690b820d",
      "legacyDayAnchor": "itinerary-day-4",
      "legacyEventOrdinal": 5,
      "sourceText": "Grab bites from A’Marenna Bakery or Piennolo, stroll Villa Comunale di Sorrento park, then have limoncello and gelato at I Giardini di Cataldo."
    },
    {
      "eventId": "event_a1020d8a668d",
      "dayId": "day_3bf42682cbed",
      "legacyDayAnchor": "itinerary-day-5",
      "legacyEventOrdinal": 1,
      "sourceText": "Pick up rental car at Hertz. Corso Italia 261/B. International Driving Permit required; return car by 7:00 PM."
    },
    {
      "eventId": "event_0ecb1373ff6a",
      "dayId": "day_3bf42682cbed",
      "legacyDayAnchor": "itinerary-day-5",
      "legacyEventOrdinal": 2,
      "sourceText": "Drive to and explore Pompeii Archaeological Park. Bring snacks and water; use the free booklet."
    },
    {
      "eventId": "event_2b7049aa5f5b",
      "dayId": "day_3bf42682cbed",
      "legacyDayAnchor": "itinerary-day-5",
      "legacyEventOrdinal": 3,
      "sourceText": "Dinner reservation: Caupona. Via Masseria Curato 2, Pompeii."
    },
    {
      "eventId": "event_7307904d3e10",
      "dayId": "day_3bf42682cbed",
      "legacyDayAnchor": "itinerary-day-5",
      "legacyEventOrdinal": 4,
      "sourceText": "Return the rental car to Hertz in Sorrento."
    },
    {
      "eventId": "event_bfccb7dbca60",
      "dayId": "day_56b7a3bb49ca",
      "legacyDayAnchor": "itinerary-day-6",
      "legacyEventOrdinal": 1,
      "sourceText": "Meet the group tour at Piazza Angelina Lauro. Eight-hour excursion: Positano (1 hour), Amalfi (1 hour) and Ravello (2 hours)."
    },
    {
      "eventId": "event_9c963b6de244",
      "dayId": "day_56b7a3bb49ca",
      "legacyDayAnchor": "itinerary-day-6",
      "legacyEventOrdinal": 2,
      "sourceText": "Explore Piazza Torquato Tasso (antiques and crafts market open until 8:00 PM), visit Stinga Tarsia woodcrafts, then dine at Annaré (Corso Italia 198/B)."
    },
    {
      "eventId": "event_42b29dc6291e",
      "dayId": "day_a8b378f6b86c",
      "legacyDayAnchor": "itinerary-day-7",
      "legacyEventOrdinal": 1,
      "sourceText": "Ferry from Sorrento back to Naples."
    },
    {
      "eventId": "event_6b76de505549",
      "dayId": "day_a8b378f6b86c",
      "legacyDayAnchor": "itinerary-day-7",
      "legacyEventOrdinal": 2,
      "sourceText": "Italo First Class train from Naples to Roma Termini. Includes train lounge access."
    },
    {
      "eventId": "event_16875db47767",
      "dayId": "day_a8b378f6b86c",
      "legacyDayAnchor": "itinerary-day-7",
      "legacyEventOrdinal": 3,
      "sourceText": "Leonardo Express from Roma Termini to FCO Airport."
    },
    {
      "eventId": "event_e3798453c1e7",
      "dayId": "day_a8b378f6b86c",
      "legacyDayAnchor": "itinerary-day-7",
      "legacyEventOrdinal": 4,
      "sourceText": "Hilton Rome Airport Hotel."
    },
    {
      "eventId": "event_5070e93567f1",
      "dayId": "day_fedb026f091b",
      "legacyDayAnchor": "itinerary-day-8",
      "legacyEventOrdinal": 1,
      "sourceText": "Flight departs Rome (FCO)."
